:root {
  --sidebar-width: 300px;
  --primary-color: #2c3e50;
  --accent-color: #3498db;
}

body {
  background-color: #f0f2f5;
  display: flex;
  height: 100vh;
  overflow: hidden;
  font-family: "Segoe UI", sans-serif;
}

/* ── Sidebar ── */
#sidebar {
  width: var(--sidebar-width);
  background: var(--primary-color);
  color: white;
  padding: 24px 20px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

#sidebar h4 {
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 0.5px;
}

#sidebar .section-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 1px;
  margin-top: 8px;
}

#uploadStatus {
  font-size: 0.82rem;
  min-height: 20px;
  margin-top: 4px;
}

/* FIX #13: New Chat button styled and visible */
#newChatBtn {
  margin-top: auto;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  transition: background 0.2s;
}
#newChatBtn:hover {
  background: rgba(255, 255, 255, 0.18);
  color: white;
}

/* ── Main Content ── */
#main-content {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  padding: 20px;
  min-width: 0;
}

#chat-window {
  flex-grow: 1;
  background: white;
  border-radius: 16px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  padding: 24px;
  overflow-y: auto;
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ── Messages ── */
.msg {
  padding: 12px 18px;
  border-radius: 16px;
  max-width: 78%;
  line-height: 1.55;
  font-size: 0.93rem;
  word-break: break-word;
  white-space: pre-wrap;
}

.user-msg {
  background: var(--accent-color);
  color: white;
  align-self: flex-end;
  border-bottom-right-radius: 4px;
}

.ai-msg {
  background: #f1f3f5;
  color: #222;
  align-self: flex-start;
  border-bottom-left-radius: 4px;
}

.ai-msg.error {
  background: #fff0f0;
  color: #c0392b;
  border: 1px solid #f5c6cb;
}

/* Typing indicator */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 14px 18px;
  background: #f1f3f5;
  border-radius: 16px;
  border-bottom-left-radius: 4px;
  align-self: flex-start;
  max-width: 80px;
}
.typing-indicator span {
  width: 8px;
  height: 8px;
  background: #aaa;
  border-radius: 50%;
  animation: bounce 1.2s infinite;
}
.typing-indicator span:nth-child(2) {
  animation-delay: 0.2s;
}
.typing-indicator span:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%,
  60%,
  100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-6px);
  }
}

/* ── Input Bar ── */
#input-bar {
  display: flex;
  gap: 8px;
}

#userInput {
  border-radius: 24px;
  padding: 10px 18px;
  border: 1px solid #dee2e6;
  font-size: 0.93rem;
  flex-grow: 1;
}

#userInput:focus {
  outline: none;
  border-color: var(--accent-color);
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.15);
}

#sendBtn {
  border-radius: 24px;
  padding: 10px 22px;
  font-weight: 600;
  background: var(--accent-color);
  border: none;
}

#sendBtn:disabled {
  background: #adb5bd;
}

.spinner-border {
  width: 0.9rem;
  height: 0.9rem;
  border-width: 2px;
}
